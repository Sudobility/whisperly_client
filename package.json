{
  "name": "@sudobility/whisperly_client",
  "version": "1.0.61",
  "description": "React client library for Whisperly API with TanStack Query hooks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "bunx vitest run",
    "test:run": "bunx vitest run",
    "lint": "bunx eslint src --ext .ts,.tsx",
    "lint:fix": "bunx eslint src --ext .ts,.tsx --fix",
    "format": "bunx prettier --write src/**/*.ts",
    "format:check": "bunx prettier --check src/**/*.ts",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build"
  },
  "keywords": [
    "whisperly",
    "localization",
    "translation",
    "api-client",
    "react",
    "tanstack-query",
    "typescript"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/di": "^1.5.76",
    "@sudobility/types": "^1.9.75",
    "@sudobility/whisperly_types": "^1.0.42",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~5.2.0",
    "eslint-plugin-react-refresh": "~0.4.26",
    "jsdom": "~27.4.0",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.0",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/whisperly_client.git"
  }
}
